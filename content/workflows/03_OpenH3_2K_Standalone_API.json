{
  "119": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "minimax_h3_video_vae_int8_convrot.safetensors"
    }
  },
  "120": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "minimax_h3_audio_vae_fp32.safetensors"
    }
  },
  "128": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen3vl_32b_minimax_h3_int8_convrot.safetensors",
      "type": "minimax",
      "device": "default"
    }
  },
  "127": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "minimax_h3_ref2va_pruned_int8_convrot.safetensors",
      "weight_dtype": "default"
    },
    "_meta": {
      "title": "MiniMax H3 Official Ref2VA INT8"
    }
  },
  "142": {
    "class_type": "MiniMaxH3SigmaShift",
    "inputs": {
      "model": [
        "127",
        0
      ],
      "shift_video": 12.0,
      "shift_audio": 3.0
    }
  },
  "b15_load_video": {
    "class_type": "LoadVideo",
    "inputs": {
      "file": "draft.mp4"
    },
    "_meta": {
      "title": "① 上传待精修的低清视频 (draft.mp4)"
    }
  },
  "b15_video_comp": {
    "class_type": "GetVideoComponents",
    "inputs": {
      "video": [
        "b15_load_video",
        0
      ]
    },
    "_meta": {
      "title": "② 拆出原视频画面与原声"
    }
  },
  "b15_prep_draft": {
    "class_type": "OpenH3RegenPrepareDraft",
    "inputs": {
      "images": [
        "b15_video_comp",
        0
      ],
      "size": "keep (snap to 32)",
      "max_frames": 0,
      "source_fps": 0.0
    },
    "_meta": {
      "title": "③ 帧尺寸对齐 (32倍数)"
    }
  },
  "b15_vae_encode": {
    "class_type": "VAEEncode",
    "inputs": {
      "pixels": [
        "b15_prep_draft",
        0
      ],
      "vae": [
        "119",
        0
      ]
    },
    "_meta": {
      "title": "④ 编码为 H3 视频潜变量"
    }
  },
  "b15_upscale": {
    "class_type": "MinimaxH3LatentUpscaler3D",
    "inputs": {
      "latent": [
        "b15_vae_encode",
        0
      ],
      "model_name": "minimax_h3_latent_upscaler_3d_conv_v1/minimax_h3_latent_upscaler_3d_conv_v1_fp16.safetensors",
      "mode": "scale by multiplier",
      "mode.scale": 2.0,
      "align": 32,
      "enable_temporal_chunking": true,
      "force_unload": true,
      "device": "cuda",
      "precision": "fp16"
    },
    "_meta": {
      "title": "⑤ 3D 潜变量 2.0x 放大 (1080p / 2K)"
    }
  },
  "b15_concat": {
    "class_type": "OpenH3RegenRefineLatent",
    "inputs": {
      "latent": [
        "b15_upscale",
        0
      ],
      "audio_mode": "silence (reference)",
      "audio_vae": [
        "120",
        0
      ]
    },
    "_meta": {
      "title": "⑥ 准备单视频精修潜变量"
    }
  },
  "b15_text_cond": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "128",
        0
      ],
      "text": "same content and motion as the draft video, photorealistic, natural skin texture, fine detail, sharp focus"
    },
    "_meta": {
      "title": "⑦ 单视频精修提示词"
    }
  },
  "b15_regen_lora": {
    "class_type": "OpenH3RegenLora",
    "inputs": {
      "model": [
        "142",
        0
      ],
      "lora_name": "open_h3_regenerate_2k_lora.safetensors",
      "curve_name": "sharp_curve_branches.safetensors",
      "curve_table": "minimax_h3_ref2va_pruned_int8_convrot.safetensors",
      "strength": 1.0,
      "curve_strength": 0.65,
      "lora_dtype": "bf16"
    },
    "_meta": {
      "title": "⑧ Open-H3 2K 精修 LoRA + Sharp 50层高频锐化曲线"
    }
  },
  "b15_guider": {
    "class_type": "BasicGuider",
    "inputs": {
      "model": [
        "b15_regen_lora",
        0
      ],
      "conditioning": [
        "b15_text_cond",
        0
      ]
    }
  },
  "b15_sampler": {
    "class_type": "KSamplerSelect",
    "inputs": {
      "sampler_name": "euler"
    }
  },
  "b15_noise": {
    "class_type": "RandomNoise",
    "inputs": {
      "noise_seed": 42
    }
  },
  "b15_schedule": {
    "class_type": "OpenH3RegenSigmas",
    "inputs": {
      "steps": 3,
      "start_sigma": 0.78
    },
    "_meta": {
      "title": "⑨ 3步 Euler 调度 (start_sigma=0.78 锁动作)"
    }
  },
  "b15_refine": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": [
        "b15_noise",
        0
      ],
      "guider": [
        "b15_guider",
        0
      ],
      "sampler": [
        "b15_sampler",
        0
      ],
      "sigmas": [
        "b15_schedule",
        0
      ],
      "latent_image": [
        "b15_concat",
        0
      ]
    },
    "_meta": {
      "title": "⑩ Open-H3 单视频 2K 精修采样"
    }
  },
  "122": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "b15_refine",
        0
      ],
      "vae": [
        "119",
        0
      ]
    }
  },
  "b15_finish": {
    "class_type": "OpenH3RegenFinish",
    "inputs": {
      "images": [
        "122",
        0
      ],
      "frame_count": [
        "b15_prep_draft",
        1
      ],
      "crop": "none",
      "audio": [
        "b15_video_comp",
        1
      ]
    },
    "_meta": {
      "title": "⑪ 裁齐帧数并无损接回原视频音频"
    }
  },
  "130": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": [
        "b15_finish",
        0
      ],
      "audio": [
        "b15_finish",
        1
      ],
      "fps": 24,
      "bit_depth": 8
    }
  },
  "92": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": [
        "130",
        0
      ],
      "format": "auto",
      "codec": "auto",
      "filename_prefix": "openh3_2k_standalone_refined"
    }
  }
}